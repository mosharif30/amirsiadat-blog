{
  "name": "amirsiadat-blog",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "setup": "prisma migrate deploy && prisma db seed",
    "admin:create": "tsx scripts/create-admin.ts",
    "postinstall": "prisma generate",
    "start:prod": "sh scripts/docker-start.sh"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-heading": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "image-size": "2.0.4",
    "jose": "6.2.13",
    "next": "16.4.3",
    "prisma": "7.10.1",
    "prismjs": "1.30.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "reading-time": "1.5.0",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "sass": "1.106.1",
    "tsx": "4.23.15",
    "unified": "11.0.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/prismjs": "1.26.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "happy-dom": "21.0.4",
    "postcss": "8.5.31",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
