# --- Database -------------------------------------------------------------------------------
# SQLite file (relative paths resolve from the project root). For PostgreSQL see README.md.
DATABASE_URL="file:./data/blog.db"

# --- Auth -----------------------------------------------------------------------------------
# Secret used to sign admin session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"

# Initial admin account created by `npm run db:seed` (only if no user with this email exists).
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-now"
ADMIN_NAME="Admin"

# --- Site -----------------------------------------------------------------------------------
# Public URL, used for canonical URLs, OpenGraph tags, the sitemap and the RSS feed.
SITE_URL="http://localhost:3000"
# Time zone used to print post dates.
SITE_TIMEZONE="UTC"

# --- Uploads --------------------------------------------------------------------------------
# "local" stores files in UPLOAD_DIR and serves them at /uploads/*.
STORAGE_DRIVER="local"
UPLOAD_DIR="./storage/uploads"
MAX_UPLOAD_MB="10"
